<launch>
  <!-- OAK-D-Pro configuration: 640x480 RGB + Depth with registration -->
  <!-- We don't need URDF since we publish static TF directly -->

  <!-- Start nodelet manager -->
  <node name="oak_nodelet_manager" pkg="nodelet" type="nodelet" args="manager" output="screen" />

  <!-- Load camera nodelet with board recovery enabled for unbooted device -->
  <node name="camera" pkg="nodelet" type="nodelet" output="screen"
        args="load depthai_ros_driver/Camera oak_nodelet_manager">
    <param name="camera_name" value="camera" />
    <param name="camera_model" value="OAK-D-PRO" />
    <param name="board_recover" value="true" />
    <param name="enable_pointcloud" value="true" />
    <param name="rs_compat" value="true" />
    <param name="camera_i_rs_compat" value="true" />

    <!-- RGB settings -->
    <param name="rgb_enabled" value="true" />
    <param name="rgb_width" value="640" />
    <param name="rgb_height" value="480" />
    <param name="rgb_fps" value="10" />

    <!-- Depth settings - 降回640x480减轻压力 -->
    <param name="depth_enabled" value="true" />
    <param name="depth_width" value="640" />
    <param name="depth_height" value="480" />
    <param name="depth_fps" value="10" />
    <param name="lrcheck" value="true" />
    <param name="extend_disparity" value="true" />
    <param name="stereo_conf_threshold" value="150" />
    <param name="ir_laser_dot_projector_current_mA" value="0" />
    <param name="depth_filter_size" value="5" />
    <param name="enable_pointcloud" value="true" />

    <!-- Enable depth registration to RGB -->
    <param name="register_depth" value="true" />

    <!-- Remap topics - rs_compat=true already outputs RealSense format:
         /camera/color/image_raw, /camera/color/camera_info, /camera/depth_registered/image_raw
         No remap needed!
    -->
  </node>

  <!-- Static TF: base_link → camera_link
       Adjust XYZ/RPY to match your actual mounting position
       Default: camera is 0.1m in front of drone center on X-axis -->
  <node pkg="tf" type="static_transform_publisher" name="oak_d_base_to_camera"
        args="0.1 0 0 0 0 0 base_link camera_link 100" />

  <!-- For local debugging: publish static world → base_link
       When flying with PX4, this is published by mavros -->
  <node pkg="tf" type="static_transform_publisher" name="oak_d_world_to_base"
        args="0 0 0 0 0 0 world base_link 100" />

  <!-- Static TF: camera_link → camera_rgb_camera_optical_frame
       With register_depth enabled, depth is aligned to RGB frame,
       so depth image header is in RGB optical frame.
       Optical frame: X→right, Y→down, Z→forward
       This rotation converts from camera_link (X→forward) to optical frame -->
  <node pkg="tf" type="static_transform_publisher" name="oak_d_camera_to_optical"
        args="0 0 0 -1.5708 0 -1.5708 camera_link camera_rgb_camera_optical_frame 100" />

  <!-- For local debugging: publish static odometry at origin (drone is stationary)
       When flying with PX4, this is published by mavros -->
  <!-- NOTE: disabled because we have static_odom_publisher.py publishes it with correct timestamps
       leaving this would cause double publish which messes up time synchronization
  <node pkg="topic_tools" type="static" name="static_odom"
        args="nav_msgs/Odometry '{header: {frame_id: world, child_frame_id: base_link}, pose: {pose: {position: {x: 0, y: 0, z: 1.0}, orientation: {w: 1}}}}}' /mavros/local_position/odom" />
  -->

  <!-- Pointcloud is already generated by OAK-D driver with depth registration
       No need for extra conversion - removed redundant node to avoid alignment error -->


</launch>